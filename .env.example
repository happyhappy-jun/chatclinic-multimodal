APP_ENV=development
MAX_EXAMPLE_VARIANTS=8
DEFAULT_GENOME_BUILD=GRCh37
PUBMED_EMAIL=your-email@example.com
LITERATURE_MAX_RESULTS=4
LITERATURE_TIMEOUT_SECONDS=8
ANNOTATION_TIMEOUT_SECONDS=8
EXTERNAL_HTTP_CACHE_TTL_SECONDS=86400
OPENAI_MODEL=gpt-5-mini
OPENAI_WORKFLOW_MODEL=gpt-5-nano
OPENAI_TIMEOUT_SECONDS=20
# OPENAI_API_KEY=your-key

# --- Clinical Guideline RAG (medical-rag team) ---
# Generation: local vLLM server (Qwen/Qwen3-8B). No OpenAI key used by the RAG tools.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=qwen3-8b
LOCAL_LLM_THINKING=false
LOCAL_LLM_TIMEOUT_SECONDS=120
# Retrieval: local embedding model + FAISS index
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu                 # cpu (default) | cuda | cuda:N — put bge-m3 on a free GPU for speed
GUIDELINE_CORPUS_DIR=examples/guidelines
GUIDELINE_INDEX_DIR=data/guideline_index
